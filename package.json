{
  "name": "pipeline-jenkins",
  "version": "1.0.0",
  "description": "Simple Node.js + TypeScript + Express app with a Jenkins CI/CD pipeline",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
